# ── Database ──────────────────────────────────────────────
# Local development (SQLite — default, no setup needed):
DATABASE_URL=sqlite:///./jobtrack.db

# Production (Supabase PostgreSQL — uncomment and fill in):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ── Auth & Security ──────────────────────────────────────
SECRET_KEY=replace-with-a-secure-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Frontend CORS ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
